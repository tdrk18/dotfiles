{
  "effortLevel": "high",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1"
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "repo": "openai/codex-plugin-cc",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/notify-permission-request.sh",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/logger-command.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/shota.todoroki/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/tdrk18/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/scripts/notify-stop.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "Opus",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(xcrun simctl spawn:*)",
      "Bash(xcrun simctl launch:*)",
      "Bash(xcrun simctl io:*)",
      "Bash(xcrun simctl boot:*)",
      "Bash(xcodebuild test:*)",
      "Bash(./gradlew ktlintFormat:*)",
      "Bash(~/.claude/scripts/codex-send.sh:*)",
      "Bash(~/.claude/scripts/codex-review.sh:*)"
    ],
    "ask": [
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)"
    ]
  },
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/scripts/statusline.sh",
    "type": "command"
  },
  "tui": "fullscreen"
}